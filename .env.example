# Every environment variable this repo reads. Copy it and fill in what you need:
#
#     cp .env.example .env
#
# NONE OF THESE ARE REQUIRED FOR THE SITE. With an empty .env — i.e. a fresh clone —
# `npm run dev`, `npm run build` and `npm run verify` all pass and every route renders.
# The site degrades on purpose rather than refusing to boot; see "What breaks when
# unset" at the bottom for exactly what you give up.
#
# Values are left EMPTY rather than filled with PASTE_ME placeholders, so that a copied
# file behaves identically to no file at all. An empty string is falsy in both runtimes
# (`!url` in the Route Handlers, `.strip()` in publish_to_supabase.env_any), whereas a
# literal placeholder would look configured to Next and send a real request to a bogus
# host.
#
# WHICH FILE IS READ BY WHAT — the two halves of the repo do not agree, so put shared
# values in `.env`:
#   Next    reads .env.local, then .env (local wins). Both are gitignored.
#   Python  reads .env ONLY (publish_to_supabase.load_dotenv, ad_fetch_bb.load_env).
# On Vercel none of this applies: set the site's vars in the project's env settings.


# ── Supabase, as the SITE names it ────────────────────────────────────────────
# Read by src/lib/supabase/server.ts, src/app/api/waitlist/route.ts and
# src/app/api/uploads/sign/route.ts. Backs live arcs, the waitlist and video uploads.

# The project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The service_role / secret key, e.g. sb_secret_... — it BYPASSES RLS and must never
# reach the browser. Deliberately not NEXT_PUBLIC_, so Next cannot inline it into the
# client bundle. Server code only.
SUPABASE_SECRET_KEY=


# ── Supabase, as the PIPELINE names it ────────────────────────────────────────
# publish_to_supabase.py accepts either naming (URL_VARS / KEY_VARS) and prefers these
# when both are set, so one .env carrying all four serves the site and the pipeline.
# Only the key is required there — the URL falls back to DEFAULT_URL in that file.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# ── Ad ingestion (ad_fetch_bb.py only) ────────────────────────────────────────
# Nothing in the site or the gate touches these. They are for pulling competitor ad
# creatives; the rest of the pipeline runs on local files.

# Browserbase API key. ad_fetch_bb.py exits immediately without it.
BROWSERBASE_API_KEY=

# Model id for the Stagehand browser agent. Optional even for ad_fetch_bb.py —
# defaults to google/gemini-2.5-flash.
SOMA_STAGEHAND_MODEL=

# Meta Ad Library Graph API user token, with the ads_read scope. Only the `metaapi`
# source uses it, and outside the EU that API indexes political / social-issue ads
# only — it will not return ordinary commercial creatives.
META_ACCESS_TOKEN=


# ── The gate ──────────────────────────────────────────────────────────────────
# Base URL for scripts/smoke.mjs. You almost certainly do not need to set this:
# scripts/verify.sh sets it per-invocation to the production `next start` it spawns
# (VERIFY_PORT, default 3099), and smoke.mjs's own default is the same port. Set it to
# point a standalone smoke pass at a deploy preview instead.
SMOKE_URL=


# ── What breaks when unset ────────────────────────────────────────────────────
# Supabase unconfigured:
#   GET  /api/arcs         -> 200 with [] , never a 500. /demo then plays the bundled
#                             samples in public/arcs/*.json, which is the designed
#                             baseline rather than a fallback of last resort.
#   POST /api/waitlist     -> 500 {"error":"Waitlist is not configured."}
#   POST /api/uploads/sign -> 500 {"error":"Uploads are not configured."}
#   publish_to_supabase.py -> refuses with the export line to run, before any network.
# BROWSERBASE_API_KEY unset:
#   ad_fetch_bb.py         -> exits "[fatal] BROWSERBASE_API_KEY not set".
# META_ACCESS_TOKEN unset:
#   ad_fetch_bb.py         -> the `metaapi` source prints how to get one, returns no
#                             rows, and the other sources still work.
