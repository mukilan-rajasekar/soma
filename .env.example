# ============================================================================
# Soma — env template.  Copy to `.env` and fill in your own values:
#     cp .env.example .env
# `.env` is git-ignored; this `.env.example` is committed (no real secrets here).
# publish_to_supabase.py auto-loads `.env` from the repo root.
# ============================================================================

# Supabase project URL (not secret) — Dashboard → Settings → API → Project URL
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"

# SECRET — service_role key (bypasses RLS, server-side only, never in the browser)
SUPABASE_SERVICE_ROLE_KEY="sb_secret_...service-role-secret..."

# Public — anon / publishable key (safe; the browser reads it from demo/supabase-config.js)
SUPABASE_ANON_KEY="sb_publishable_...public-key..."
