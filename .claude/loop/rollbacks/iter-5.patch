+    // and fixes the dead numeral with one move. Iterated, because moving up can bring a new
+    // figure into shot; three passes converges on this page and the loop is bounded anyway.
+    //
+    // Deliberately allowed to exceed `ceil`, on the same principle the gate floor already
+    // uses: an eyebrow tucked under the header is a much smaller defect than a live figure
+    // frozen at zero in the middle of the shot.
+    for (let pass = 0; pass < 3; pass++) {
+      const onCamera = figs.filter((g) => g.top >= s && g.top < s + vh && g.fireAt > s);
+      if (!onCamera.length) break;
+      const need = Math.max(...onCamera.map((g) => g.fireAt)) + GATE_MARGIN;
+      if (need <= s) break;
+      s = Math.min(need, maxScroll);
+    }
