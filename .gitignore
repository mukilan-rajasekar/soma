# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries names and comments only, never a value.
# Without this negation `.env*` above swallows it and a fresh clone gets no pointer
# to any of the eight variables the code reads.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python (the pipeline scripts at the repo root)
# unanchored, so it catches tools/__pycache__ etc., not just the root one
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# demo/process_batch.py working dirs. The preds cache alone is ~3 MB per ad per mode
# (float32, T x 20484) — 10 inferences is ~30 MB that must never land in a commit.
# The Schaefer .annot downloads and the padded stimuli live here too.
demo/.cache/
demo/out/

# Colab notebooks carry inline tokens — never commit
colab_extract.ipynb
colab_overnight.ipynb
colab_overnight_full.ipynb

# colab upload bundles (soma_ads_7.zip alone is 58 MB) — never commit
colab_upload/

# One-shot playwright scratch scripts. These get written mid-session to check a
# single change (hardcoded to the :3055 dev server and to a /tmp scratchpad that
# is gone by the next session), so they are dead on arrival in a fresh checkout.
# Anchored to the root: scripts/loop.sh runs `git add -A`, which would otherwise
# commit every one of them. The keepers live in tools/ and take argv instead.
/_*.mjs

# Local-only working directories. None of these is tracked on this branch, so a
# fresh clone does not have them — nothing that runs in CI or in the gate may
# read from one. They were hidden only by .git/info/exclude until now, and that
# file lives inside .git: it exists on exactly one machine. Everywhere else
# scripts/loop.sh's `git add -A` would have swept all of it into a commit.
#
#   data/   ~11 GB of stimuli, fMRI derivatives and model outputs. Never been in
#           git on any branch; there is no copy to restore from.
#   tests/  synthetic fixtures (tests/synth/, 26 MB) regenerated by
#           tests/make_synthetic_data.py. The test sources that read them are
#           parked on branch muki/oldlandingpage, not here — so a test_*.py on
#           this branch must build its own fixtures rather than reach into
#           tests/synth/, which passes locally and fails in every other checkout.
#   cloud/  colab/runpod scratch, also parked on muki/oldlandingpage.
/data/
/tests/
/cloud/

# gstack browse/audit session logs. Unanchored: they appear at the repo root and
# under demo/ depending on where the tool was invoked.
.gstack/

# Run outputs from the concierge / edit / generate tooling. Local artifacts of a
# run, never source: tools/concierge/run_batch.py, tools/edit/search.py and
# tools/generate/pipeline.py all write here by default.
concierge-runs/
edits/
generated/
ingest-runs/

# `supabase link` writes the linked project ref here. Machine-local state, not source —
# the ref belongs in whoever's shell is applying migrations, not in the tree.
supabase/.temp/

# impeccable (design tooling) cache. hook.cache.json holds names of components
# that no longer exist; listing the directory here keeps it out of commits and
# out of rg / git grep results, which is where the stale names kept surfacing.
.impeccable/

# Generated share bundles (tools/corpus/bundle.py). Derived from /data/, which is
# already ignored — keep the derivative out too rather than committing a copy of it.
/dist/
